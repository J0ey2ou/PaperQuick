{
  "manifest_version": 3,
  "name": "文献直达 · 右键查原文",
  "version": "2.4.2",
  "description": "选中标题查原文；配合文献直达阅读器，将选区和正文交给 ChatGPT，并复用同篇对话。",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.crossref.org/*", "https://www.ebi.ac.uk/*", "https://export.arxiv.org/*", "https://api.semanticscholar.org/*", "https://api.unpaywall.org/*", "https://chatgpt.com/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {"matches": ["https://chatgpt.com/*"], "js": ["chat-content.js"], "run_at": "document_start"},
    {"matches": ["http://127.0.0.1/*"], "js": ["chat-launch.js"], "run_at": "document_start"}
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "查找当前页面中的论文"},
  "options_page": "results.html",
  "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}
}
